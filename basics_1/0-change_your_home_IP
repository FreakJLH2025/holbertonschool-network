#!/usr/bin/env bash
# This script configures localhost to 127.0.0.2 and facebook.com to 8.8.8.8

# Backup the current hosts file
sudo cp /etc/hosts /etc/hosts.bak

# Overwrite /etc/hosts with the required entries
sudo bash -c 'cat > /etc/hosts <<EOF
127.0.0.2   localhost
8.8.8.8     facebook.com
EOF'
